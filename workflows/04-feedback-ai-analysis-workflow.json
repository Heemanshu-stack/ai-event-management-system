    {
      "parameters": {
        "jsCode": "const rows = $input.all();\n\nlet feedback = \"\";\n\nfor (const row of rows) {\n\nfeedback += `\nParticipant: ${row.json[\"  Full Name  \"]}\nParticipant ID: ${row.json[\"Participant ID \"]}\nEmail: ${row.json[\"  Email Address  \"]}\nEvent: ${row.json[\"  Event Name  \"]}\nOverall Rating: ${row.json[\"  Overall Rating  \"]}/5\n\nWhat did they like?\n${row.json[\"  What did you like the most about the event?  \"]}\n\nWhat can we improve?\n${row.json[\"  What can we improve?  \"]}\n\nWould attend another event?\n${row.json[\"  Would you attend another event organized by us?  \"]}\n\nWould recommend the event?\n${row.json[\"  Would you recommend this event to your friends?  \"]}\n\nAdditional Comments:\n${row.json[\"  Any additional comments or suggestions?  \"]}\n\n----------------------------------------------------------\n\n`;\n\n}\n\nreturn [\n  {\n    json: {\n      feedback\n    }\n  }\n];"
      },
